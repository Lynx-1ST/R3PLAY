{
  "name": "server",
  "version": "2.9.3",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "scripts": {
    "postinstall": "prisma generate && node scripts/install-sqlite3.js",
    "start": "fastify start --port 35530 --address 0.0.0.0 -l info dist/packages/server/src/app.js",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/migrations', 'dist/packages/server/src/migrations', { recursive: true })\"",
    "watch": "tsc -w",
    "dev": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch\" \"npm:dev:start\"",
    "dev:start": "fastify start --port 35530 --address 0.0.0.0 -l info dist/packages/server/src/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@neteasecloudmusicapienhanced/api": "^4.40.0",
    "@prisma/client": "^6.19.3",
    "@unblockneteasemusic/server": "^0.28.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "change-case": "^4.1.2",
    "compare-versions": "^6.1.1",
    "fastify": "^5.12.2",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0",
    "log4js": "^6.9.1",
    "music-metadata": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "concurrently": "^7.6.0",
    "fastify-tsconfig": "^1.0.1",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
